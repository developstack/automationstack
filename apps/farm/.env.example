# apps/farm 的环境变量。复制成 apps/farm/.env 再填：
#   cp apps/farm/.env.example apps/farm/.env
#
# 权威 schema 有**两份**，farm 进程同时吃：
#   - packages/env/src/farm.ts   —— FARM_* （本文件下半部分）
#   - packages/env/src/server.ts —— DATABASE_URL / SESSION_SECRET / R2_* 等，
#     farm 经 packages/db、packages/api 用到它们，清单见 apps/server/.env.example
# 改了 schema 记得同步这里。
#
# 通用规则同 server：emptyStringAsUndefined: true，留空 == 没设 == 走默认值/关掉。

# ── 必需（经 packages/env/src/server.ts 校验，缺了进程起不来）─────────────────

# Postgres 连接串。会话与产物落这个库，与 server 是**同一个库**。
# 本地连 Homebrew 的 Postgres：postgresql://<user>:<pass>@localhost:5432/automationstack
# 连 compose 起的那个：端口 5433。容器内不用管，docker-compose.yml 会注入。
DATABASE_URL=

# 会话 cookie 签名密钥，≥32 字符。farm 自己不签发会话，但它 import 的
# packages/api 会读这个变量，缺了 env 校验直接退出。填成和 apps/server/.env 同一个值。
SESSION_SECRET=

# 允许跨域的前端 origin。同上：farm 不用它，但共享 schema 要求它是合法 URL。
CORS_ORIGIN=

# ── FARM_*：全部有默认值 ────────────────────────────────────────────────────

# farm 的 HTTP/WS 监听端口。默认 3002（3000 是 server，3001 是 web）。
# 改了记得同步 docker-compose.yml 的端口映射与 FARM_PUBLIC_URL。
FARM_PORT=

# farm 在**用户视角**的地址：接入指南页生成的示例代码、产物下载链接都从它拼。
# 默认 http://localhost:3002。和 FARM_PORT 分开是因为反代之后
# 「监听端口」和「对外 URL」根本不是一回事。
FARM_PUBLIC_URL=

# Docker daemon 地址。默认 unix:///var/run/docker.sock。
# 远程 daemon 推荐 ssh://user@host（B 机不暴露任何 Docker 端口）；
# tcp://host:2376 必须配双向 TLS。
# ⚠️ 严禁明文 tcp://host:2375 —— Docker API 等价于宿主 root 权限。
# daemon 在哪台机器，浏览器镜像就要构建/加载在哪台（scripts/build-browser-images.sh）。
FARM_DOCKER_HOST=

# 会话端点的取法：published-port（默认）| container-ip。
#   published-port —— 浏览器容器发布随机宿主端口，farm 连宿主。
#                     **本地开发专用**：macOS 的 Docker Desktop 连不通容器 IP。
#   container-ip   —— farm 自己也在容器里、与浏览器容器同网时直连容器 IP，
#                     省一跳，浏览器容器不发布任何宿主端口。这是生产路径。
FARM_ENDPOINT_MODE=

# container-ip 模式下把浏览器容器挂进哪张网，通常是 compose 网络
# （名字形如 automationstack_default，用 docker network ls 确认）。
# published-port 模式下留空。
FARM_DOCKER_NETWORK=

# published-port 模式下，容器端口发布在哪台机器上（farm 与 daemon 分离部署时填
# daemon 那台的内网 IP）。留空即同机，回落 127.0.0.1。
# ⚠️ 分离部署时 A↔B 的延迟会进**每一条** WebDriver 命令（协议啰嗦，逐命令 HTTP
# 往返），要求同机房/同 VPC。
FARM_ADVERTISE_HOST=

# 全局并发会话上限。默认 8。超限直接 503 + Retry-After，不排队（plan §2 D11）。
# 每个会话是一个独立的 chromium 容器，这个数字的实际上限是 daemon 那台机器的
# 内存：一个 headless chromium 容器按 1G 上下估。
FARM_MAX_SESSIONS=

# 空闲超时（毫秒）。默认 120000。WebDriver 每次转发重置计时器；
# CDP 会话以 WS 存活为准，不吃这一项。
FARM_SESSION_IDLE_TIMEOUT_MS=

# 会话寿命上限（毫秒）。默认 1800000（30 分钟）。两种协议都吃，
# 防挂死会话把并发槽位占死。
FARM_SESSION_MAX_LIFETIME_MS=

# 会话过程数据（recorder 的 NDJSON、截图）的落盘根目录。
# 默认系统临时目录下的 automationstack-farm。finalize 上传 R2 之后按会话删除。
FARM_WORK_DIR=

# 目录（farm_browsers 表）没命中任何行时的兜底镜像。
# 默认 automationstack-browser-chromium:latest，与 scripts/build-browser-images.sh
# 打的 tag 对齐。
FARM_DEFAULT_BROWSER_IMAGE=

# 槽位从哪来：docker（默认，生产）| local（本机 Chrome 进程，开发机没有 Docker 时用）。
# local 模式下一条会话 = 一个 Chrome 进程组 + 一个一次性 profile 目录
# （<FARM_WORK_DIR>/local-slots/<sessionId>/），收尾时杀进程组 + 删目录；
# 孤儿回收与容器模式同构，判据从「容器 label」换成「槽位目录」。
# ⚠️ 只适合开发机：本机跑的浏览器没有容器那层隔离。
FARM_PROVIDER=

# local 模式下 Chrome/Chromium 可执行文件的路径。留空按平台探测：
# macOS 找 /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# （其次 Chromium.app），Linux 在 PATH 里找 google-chrome / chromium 等名字。
# 显式配了但不可执行会**直接报错**而不是回落探测——「跑起来了但不是你以为的
# 那个浏览器」比起不来更贵。
FARM_CHROME_BIN=

# local 模式下 chromedriver 的路径，留空查 PATH。
# **只有 WebDriver 会话需要它**，CDP（Playwright connectOverCDP）不需要；
# 缺失时也只在 acquire 那一刻报错，报错信息里带装法。
# 主版本必须与本机 Chrome 一致：
#   brew install --cask chromedriver
#   npx @puppeteer/browsers install chromedriver@<Chrome 主版本>
FARM_CHROMEDRIVER_BIN=

# local 模式下浏览器是否无头。默认 true；填 false 会真的弹出窗口，
# 本地调试时能直接看见脚本在点什么（容器模式下没有这个选项）。
FARM_LOCAL_HEADLESS=
