# apps/server 的环境变量。make up / make setup 会在缺失时自动把它复制成
# apps/server/.env，不需要手工 cp。
#
# 权威 schema 是 packages/env/src/server.ts（@t3-oss/env-core + zod），
# 这里的分组和默认值都跟着它走。
#
# ⚠️ 下面的密钥是**本地开发默认值**，部署前必须换成自己生成的随机值：
#   SESSION_SECRET / SECRET_ENCRYPTION_KEY 用 openssl rand -base64 32 生成。
#   SECRET_ENCRYPTION_KEY 换掉后，库里已存的 Jira 凭据会全部解不开，无法找回。
#   NODE_ENV=production 时，服务拒绝这些开发默认值（含 DATABASE_URL 中的数据库密码），
#   不启动。默认值清单在 packages/env/src/dev-secrets.ts。

# ── 必需 ──────────────────────────────────────────────────────────────────

# Postgres 连接串。默认是 docker compose 起的库（宿主机端口 5433）。
# 用 Homebrew 后端时改成：postgresql://<你的系统用户名>@localhost:5432/automationstack
# （Homebrew 的 initdb 用 OS 用户名，不是 postgres）。
DATABASE_URL=postgresql://postgres:automationstack-dev@127.0.0.1:5433/automationstack

# 允许跨域的前端 origin（必须是合法 URL）。要和 apps/web 的 VITE_SERVER_URL
# 成对地改，只改一边的典型症状是前端能加载但每个请求都被 CORS 挡掉。
CORS_ORIGIN=http://localhost:3001

# 会话 cookie 的 HMAC-SHA256 签名密钥，至少 32 字符。换掉 = 全员登出。
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef

# 凭据加密主密钥：base64 编码的 32 字节（AES-256）。留空则 Jira 集成不可用。
SECRET_ENCRYPTION_KEY=U0t6cb4rxrzmt9qa9Po0Txv+IoE5wZ/3ZBYkt7TBbxo=

# ── 认证与引导管理员 ──────────────────────────────────────────────────────

# 认证方式：local 或 casdoor，默认 local。
# 此项只是默认值。管理员在「认证设置」页面保存一次后，服务使用页面配置，
# 此项和下面的 CASDOOR_* 默认值不再生效。
AUTH_PROVIDER=
# casdoor 模式下是否保留本地管理员登录：true 或 false，默认 true。
# local 模式不读取此项。页面不能修改此项。
AUTH_ALLOW_LOCAL_LOGIN=

# ── 可选：Casdoor 默认值（页面配置优先）──────────────────────────────────────

# Casdoor 的集群内地址，只能在这里设置，页面只读显示。只写协议、主机和端口，
# 例如 http://casdoor.casdoor.svc.cluster.local:8000。casdoor 模式必须设置此项。
# 服务端用它读取发现文档和 JWKS、换取 token、调用管理 API。
# 本地开发（make casdoor-up）时设为 http://localhost:8100。
CASDOOR_INTERNAL_URL=
# 下面各项是「认证设置」页面的默认值。页面保存过一次后，这些值不再生效。
# Casdoor 的公网地址，只写协议、主机和端口，必须与 Casdoor 的 origin 相同。
CASDOOR_ISSUER=
# Casdoor 组织名。不能是 built-in。
CASDOOR_ORGANIZATION=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# OIDC 回调地址，必须以 /api/auth/casdoor/callback 结尾。
CASDOOR_REDIRECT_URL=
# Casdoor 中的角色名。拥有此角色的用户映射为平台管理员。
CASDOOR_ADMIN_ROLE=
# webhook 共享密钥，至少 32 个字符。Casdoor 在请求头 X-Casdoor-Webhook-Secret 中发送它。
CASDOOR_WEBHOOK_SECRET=
# Casdoor 定期对账的 cron 表达式（UTC），默认 "*/10 * * * *"（每 10 分钟）。
# 只在 casdoor 模式下执行。对账同步 Casdoor 用户的角色和禁用状态。
CASDOOR_RECONCILE_CRON=
# 引导管理员的用户名，默认 admin。
ADMIN_USERNAME=
# 引导管理员的初始密码，8–128 个字符。
# 服务启动时，如果没有可以本地登录的管理员，就用此密码创建引导管理员。
# 已有这样的管理员时，服务不读取此项，也不修改任何密码。
# ⚠️ 下面的值仅限开发使用。生产环境拒绝此值，服务不启动。
# 生产环境必须设置自己的值。引导管理员第一次登录后必须修改密码。
ADMIN_INITIAL_PASSWORD=dev-only-admin-password

# ── 可选：有默认值（留空即用默认）─────────────────────────────────────────

# development | production | test，默认 development。
# 本地 pnpm dev 用这一项。docker compose 固定为 production，不读这里的值。
NODE_ENV=
# HTTP / WebSocket 监听端口，默认 3000。
PORT=
# 本进程 Postgres 连接上限（drizzle 与 pg-boss 共用同一个池），默认 5。
# 这就是每个 server 实例最多占用的连接数；池满时请求排队，排队超过 10s 报错。
DATABASE_POOL_MAX=
# 测试报告每日自动提交扫描的 cron 表达式，默认 "0 3 * * *"。
AUTO_SUBMIT_SCAN_CRON=
# 上一项的时区，必须是 IANA 名（如 Asia/Shanghai，不能写 UTC+8），默认 Asia/Shanghai。
AUTO_SUBMIT_SCAN_TZ=

# ── 可选：留空 = 该功能不可用（不影响服务启动）─────────────────────────────

# Cloudflare R2 附件存储。留空即「未配置」，附件上传入口禁用。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ENDPOINT=
