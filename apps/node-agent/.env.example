# apps/node-agent 的环境变量。复制成 apps/node-agent/.env 再填：
#   cp apps/node-agent/.env.example apps/node-agent/.env
#
# 权威 schema 只有**一份**：packages/env/src/node-agent.ts。
# 这个进程跑在**执行机**上，它不连数据库、不连对象存储，所以这里既没有
# DATABASE_URL 也没有 R2_*——看到别处的 .env.example 有那些变量，不要抄过来。
#
# 通用规则同 server/farm：emptyStringAsUndefined: true，
# 留空 == 没设 == 走默认值/自动探测。

# ── 必需（缺了进程起不来）───────────────────────────────────────────────────

# 平台（farm）的对外地址，**填 http(s)**，agent 自己转成 ws(s)://…/nodes/connect。
# 填你在浏览器里访问平台用的那个地址就对了。
# ⚠️ 生产必须 https：节点 token 的明文在握手第一帧里，明文 ws 等于把凭据发在网上。
NODE_AGENT_FARM_URL=https://farm.example.com

# 节点凭据明文，形如 as_node_…。
# 在平台的「节点」页新建节点时**只显示这一次**，关掉就再也看不到了（库里只存哈希），
# 丢了就删掉重建一个。
NODE_AGENT_TOKEN=

# ── 可选：全部有默认值 ──────────────────────────────────────────────────────

# 槽位过程数据的落盘根目录，实际用的是 <WORK_DIR>/local-slots/<sessionId>/。
# 默认 <系统临时目录>/automationstack-node-agent。
# 这些是过程数据（浏览器 profile、日志），机器重启后没了也无所谓；
# 但如果你的临时目录会被系统在运行中清理，就在这里指一个正经目录。
NODE_AGENT_WORK_DIR=

# 本机 Chrome/Chromium 可执行文件。留空按平台探测：
#   macOS  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux  PATH 里的 google-chrome / chromium
# 探不到不会拦住启动，只在真的要开浏览器时才报错。
NODE_AGENT_CHROME_BIN=

# 本机 chromedriver。留空查 PATH。
# **只有 webdriver 模式的会话需要它**，一台只跑 CDP 会话的节点可以不装。
NODE_AGENT_CHROMEDRIVER_BIN=

# 浏览器是否无头。默认 true。
# 只认字面量 "true"/"false"（写别的会被 env 校验挡下来，而不是静默当成 true）。
# 想在这台机器上肉眼看着浏览器跑，才填 false——那要求这台机器有图形会话。
NODE_AGENT_HEADLESS=

# docker 后端要连的 daemon 地址，默认 unix:///var/run/docker.sock。
# ⚠️ 必须是**本机**的 daemon：节点跑容器的意义就是「在这台机器上跑」，
# 指向另一台机器的 daemon 会让隧道当场落空（agent 是从 127.0.0.1 连容器发布的端口）。
# 只用 local 后端的节点完全不用管这一行。
NODE_AGENT_DOCKER_HOST=
