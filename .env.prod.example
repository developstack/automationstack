# 单机生产部署（make up:prod）的配置模板。
#
# make up:prod 第一次执行时，把本文件复制成仓库根目录的 .env.prod（权限 600）。
# 以后每次执行时，本文件中新增的键自动追加到 .env.prod。.env.prod 中已有的值不变。
# .env.prod 不进入 git。重新 clone 仓库后它不存在，所以要单独备份它。
# 用其他路径：make up:prod PROD_ENV=/etc/automationstack/prod.env
#
# 本文件有两个用途：
#   1. docker compose 用它展开 docker-compose.prod.yml 中的 ${...}。
#   2. server 容器和 migrate 容器把它作为环境变量（env_file）。web 容器不读取它。
#
# 取值规则（docker compose 的 env_file 格式）：
#   - 值中有 $、#、空格或引号时，用单引号括起来：KEY='a$b c'。单引号中的内容不做替换。
#   - 注释中有 [必填] 的键为空时，make up:prod 不启动。
#   - 空值表示使用默认值。
#   - NODE_ENV、PORT、CORS_ORIGIN 和 CLIENT_IP_HEADER 由 docker-compose.prod.yml 设置，所以本文件中没有这些键。
#
# server 端的权威 schema 是 packages/env/src/server.ts。
# 在 apps/server/.env.example 中增加键时，也在本文件中增加它（scripts/prod-env.test.mjs 检查这一点）。

# ── 域名与证书 ────────────────────────────────────────────────────────────

# [必填] 站点的域名，只写主机名，例如 testcase.example.com。不写协议，不写端口。
# 在阿里云中，把它的 A 记录指向本服务器的公网 IP。
# 前端和后端都使用 https://<域名>，所以没有跨域问题。
# 浏览器的地址（VITE_SERVER_URL）和 server 的 CORS_ORIGIN 都由它得出，所以本文件中没有这两个键。
# 修改后，执行 make up:prod：它重新构建 web 镜像，并为新域名申请证书。
DOMAIN=

# Let's Encrypt 账号的邮箱。可以为空。
ACME_EMAIL=

# ── 数据库（外部机器上的 PostgreSQL）────────────────────────────────────────

# [必填] 连接串：postgresql://<角色>:<口令>@<主机>:<端口>/<库名>
# 口令中有特殊字符时，先做 URL 编码，例如 @ 写成 %40。
# 角色必须是库的 owner：迁移要创建 schema drizzle，server 要创建 schema pgboss。
# 需要 TLS 时，在结尾加 ?sslmode=require。
# 数据库在 docker 的宿主机上时，主机写 host.docker.internal，不要写 127.0.0.1。
# 这时 PostgreSQL 必须监听 docker 网桥的地址，pg_hba.conf 必须允许 docker 的网段。
DATABASE_URL=

# server 的连接池上限，默认 5。drizzle 与 pg-boss 共用这一个池。
# 增大它之前，确认数据库的 max_connections 还有余量。
DATABASE_POOL_MAX=

# ── 密钥 ──────────────────────────────────────────────────────────────────

# [必填] 会话 cookie 的签名密钥，至少 32 个字符。生成：openssl rand -base64 32
# 修改后，所有用户必须重新登录。
SESSION_SECRET=

# [必填] 凭据加密主密钥，base64 编码的 32 字节。生成：openssl rand -base64 32
# ⚠️ 设置后不要修改。修改后，库中已加密的凭据（例如 Casdoor 的 client secret）全部不能解密。
SECRET_ENCRYPTION_KEY=

# ── 认证与引导管理员 ──────────────────────────────────────────────────────

# 引导管理员的用户名，默认 admin。
ADMIN_USERNAME=

# 引导管理员的初始密码，8–128 个字符。
# 库中没有可以本地登录的管理员时，server 用它创建引导管理员。这时它为空，server 不启动。
# 已有这样的管理员时，server 不读取它，也不修改任何密码。
# 引导管理员第一次登录后必须修改密码。
ADMIN_INITIAL_PASSWORD=

# 认证方式：local 或 casdoor，默认 local。
# 此项只是默认值。管理员在「认证设置」页面保存一次后，server 使用页面配置。
AUTH_PROVIDER=

# casdoor 模式下是否保留本地管理员登录：true 或 false，默认 true。
AUTH_ALLOW_LOCAL_LOGIN=

# ── 可选：Casdoor 默认值（页面配置优先）──────────────────────────────────────
# 各键的说明见 apps/server/.env.example。

# Casdoor 的内部地址，只能在这里设置。casdoor 模式必须设置此项。
CASDOOR_INTERNAL_URL=

# Casdoor 的公网地址，必须与 Casdoor 的 origin 相同。
CASDOOR_ISSUER=

# Casdoor 组织名。不能是 built-in。
CASDOOR_ORGANIZATION=

CASDOOR_CLIENT_ID=

CASDOOR_CLIENT_SECRET=

# OIDC 回调地址，必须以 /api/auth/casdoor/callback 结尾。
CASDOOR_REDIRECT_URL=

# 映射为平台管理员的 Casdoor 角色名。
CASDOOR_ADMIN_ROLE=

# 映射为项目管理员的 Casdoor 角色名，默认 automationstack-project-admin。
CASDOOR_PROJECT_ADMIN_ROLE=

# webhook 共享密钥，至少 32 个字符。
CASDOOR_WEBHOOK_SECRET=

# Casdoor 对账的 cron 表达式（UTC），默认 "*/10 * * * *"。
CASDOOR_RECONCILE_CRON=

# ── 可选：后台任务 ─────────────────────────────────────────────────────────

# 测试报告每日自动提交扫描的 cron 表达式，默认 "0 3 * * *"。
AUTO_SUBMIT_SCAN_CRON=

# 上一项的时区，必须是 IANA 名（例如 Asia/Shanghai），默认 Asia/Shanghai。
AUTO_SUBMIT_SCAN_TZ=

# ── 可选：附件存储（为空时，附件功能不可用）─────────────────────────────────

# Cloudflare R2。五个键都设置后，附件上传可用。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ENDPOINT=

# 用例图片的公开基础地址，例如 https://img.example.com。说明见 apps/server/.env.example。
IMAGE_PUBLIC_BASE_URL=
