# 复制成 .env 再填：cp .env.example .env
# 前两个值能从平台的「接入指南」页直接抄。

# 项目 API token（as_live_ 开头）。
AS_TOKEN=

# 项目 ID（uuid）。token 的主人必须是这个项目的成员。
AS_PROJECT=

# 可选：farm 的 CDP 端点。默认 ws://localhost:3002/cdp
# 注意是 ws:// 不是 http://（平台只支持 ws 直连形态，见 plan §2 D2）。
AS_FARM_CDP_URL=

# 可选：点名要跑在哪台**执行机**（实机节点）上，填节点名；填 local 就是平台本机
# 那个内建来源。留空 = 平台按占用率自己挑。点不中会明确报错，不会悄悄换一台。
AS_NODE=
