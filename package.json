{
  "name": "automationstack",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @automationstack/db --",
    "db:studio": "turbo run db:studio -F @automationstack/db --",
    "db:generate": "turbo run db:generate -F @automationstack/db --",
    "db:migrate": "turbo run db:migrate -F @automationstack/db --",
    "db:seed": "pnpm --filter server exec tsx ../../scripts/seed.ts",
    "db:seed-admin": "pnpm --filter server exec tsx ../../scripts/seed-admin.ts",
    "db:reset-password": "pnpm --filter server exec tsx ../../scripts/reset-password.ts",
    "db:auth-set-local": "pnpm --filter server exec tsx ../../scripts/auth-set-local.ts",
    "db:seed-automation-demo": "pnpm --filter server exec tsx ../../scripts/seed-automation-demo.ts",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix"
  },
  "dependencies": {
    "@automationstack/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@automationstack/config": "workspace:*",
    "@biomejs/biome": "2.5.9",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "lefthook": "2.1.10",
    "turbo": "2.10.10",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.17.0"
}
