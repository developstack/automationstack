# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
build
*.tsbuildinfo

# Generated files
# 注意：apps/web/src/routeTree.gen.ts 刻意**不**忽略。它由 TanStack Start 的
# vite 插件生成，但 apps/web/src/router.tsx 直接 import 它，而 check-types
# 跑的是 tsc --noEmit（不经过 vite）。忽略掉的话，全新 clone 与 CI 上
# `pnpm install && pnpm check-types` 会直接报「找不到模块 ./routeTree.gen」。
# 仓库里也没装 @tanstack/router-cli（没有 tsr 命令），无法在类型检查前单独生成。
local.db
local.db-*

# Environment variables
.env
.env*.local

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
logs
.evlog/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Lint/format caches
# eslint --cache 的产物。不忽略的话，凡是本地跑过一次全仓 lint，
# 它就会混进下一次 git add，且体积随仓库增长。
.eslintcache

